{
  "name": "pathgrid",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^13.0.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.6",
    "react-scripts": "5.0.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/index.css -o ./src/tailwind.output.css --minify",
    "watch:css": "tailwindcss -i ./src/index.css -o ./src/tailwind.output.css --watch",
    "prestart": "npm run build:css",
    "start": "concurrently -k -n css,react -c cyan,green \"npm:watch:css\" \"react-scripts start\"",
    "prebuild": "npm run build:css",
    "build": "react-scripts build",
    "pretest": "npm run build:css",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  }
}
